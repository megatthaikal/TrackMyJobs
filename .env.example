# Postgres connection string (e.g. from a free Neon project: https://neon.com)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=""

# Gemini API key for the auto-extract feature (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Optional: Groq API key (free tier) — used as an automatic fallback when
# Gemini is overloaded. Get one at https://console.groq.com/keys
GROQ_API_KEY=""
